---

// On importe le CSS (Tailwind + ton design system) et un composant
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Carte from '../components/Carte.astro';

// Des variables, calculées au moment où la page est générée
const prenom = 'Wendy';
const heure = new Date().getHours();
const salutation = heure < 18 ? 'Bonjour' : 'Bonsoir';

// Une liste de données (plus tard, ce seront tes vrais projets)
const projets = [
  { titre: 'Projet exemple A', annee: 2025, techno: 'Astro', description: 'Un premier projet fictif.' },
  { titre: 'Projet exemple B', annee: 2024, description: 'Celui-ci n’a pas de techno : la valeur par défaut s’affiche.' },
  { titre: 'Projet exemple C', annee: 2023, techno: 'JavaScript', description: 'Un troisième pour remplir la grille.' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Découverte d’Astro</title>
  </head>
  <body class="mx-auto flex max-w-4xl flex-col gap-12 px-5 py-16">

    <!-- A. Afficher une variable : il suffit de l'entourer d'accolades -->
    <section>
      <h1>{salutation} {prenom} !</h1>
      <p class="text-lavande-claire">
        Ce titre change selon l’heure à laquelle la page a été générée.
      </p>
    </section>

    <!-- B. Répéter un bloc pour chaque élément d'une liste avec .map() -->
    <section class="flex flex-col gap-4">
      <h2 class="font-serif text-3xl">Mes projets ({projets.length})</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {
          projets.map((projet) => (
            <Carte titre={projet.titre} annee={projet.annee} techno={projet.techno}>
              <p>{projet.description}</p>
            </Carte>
          ))
        }
      </div>
    </section>

    <!-- C. Afficher quelque chose seulement si une condition est vraie -->
    <section>
      {projets.length >= 3 && (
        <p class="text-lavande-claire">Il y a au moins 3 projets, donc ce message s’affiche.</p>
      )}
      {projets.length === 0 ? <p>Aucun projet.</p> : <p>La liste n’est pas vide.</p>}
    </section>

    <!-- D. De l'interactivité dans le navigateur, avec une balise <script> -->
    <section class="flex items-center gap-4">
      <button
        id="compteur"
        class="rounded-lg bg-lavande px-6 py-3 font-medium text-lune hover:bg-lavande-vive"
      >
        Clique-moi
      </button>
      <p>Clics : <span id="total">0</span></p>
    </section>

  </body>
</html>

<!--
  Ce <script>, lui, s'exécute DANS LE NAVIGATEUR du visiteur.
  C'est la grande différence avec le frontmatter (en haut, entre les ---).
-->
<script>
  const bouton = document.getElementById('compteur');
  const total = document.getElementById('total');
  let clics = 0;

  bouton?.addEventListener('click', () => {
    clics++;
    if (total) total.textContent = String(clics);
  });
</script>

<!-- Ce style ne touche que les éléments de CETTE page -->
<style>
  h1 {
    font-family: 'EB Garamond Variable', Georgia, serif;
    font-size: 3.5rem;
    line-height: 1.1;
  }
</style>