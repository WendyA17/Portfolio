---
// La page d'accueil, écrite une seule fois pour toutes les langues.
// src/pages/index.astro l'affiche en français, src/pages/en/index.astro en anglais.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Phase from '../components/Phase.astro';
import Ouverture from '../components/section/Ouverture.astro';
import NavigationLunaire from '../components/NavigationLunaire.astro';
import Histoire from '../components/section/Histoire.astro';
import Competences from '../components/section/Competences.astro';
import { traductions, type Langue } from '../i18n/utils';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = traductions(langue);

// Les sections encore vides : on les remplacera une par une par leur vrai composant
const aRemplir = [ 'projets', 'etude', 'parcours', 'contact', 'fin'] as const;
const total = aRemplir.length + 3;
---

<Layout langue={langue} snap>
  <Header langue={langue} />
  <NavigationLunaire langue={langue} sections={['accueil', 'histoire', 'competences', ...aRemplir]} />

  <main>
    <Ouverture langue={langue} numero={1} total={total} />
    <Histoire langue={langue} numero={2} total={total} />
    <Competences langue={langue} numero={3} total={total} />

    {
      aRemplir.map((id, index) => (
        <Phase id={id} numero={index + 4} total={total} lune={t.phases[id].lune} titre={t.phases[id].titre}>
          <h2 class="font-serif text-5xl font-medium md:text-7xl">{t.phases[id].titre}</h2>
        </Phase>
      ))
    }
  </main>
</Layout>
