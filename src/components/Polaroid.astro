---
// Une photo façon polaroid, légèrement inclinée, avec son ruban adhésif.
// Sans photo, un emplacement provisoire s'affiche à la place.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: ImageMetadata; // ta photo, importée depuis src/assets
  alt: string;           // description de la photo (lue par les lecteurs d'écran)
  legende: string;       // le texte écrit sous la photo
  sousLegende?: string;
  format?: 'portrait' | 'carre';
  class?: string;
}

const { photo, alt, legende, sousLegende, format = 'portrait', class: classes } = Astro.props;
const ratio = format === 'carre' ? 'aspect-square' : 'aspect-4/5';
---

<figure class:list={['relative -rotate-3 bg-[#f3efe6] p-3 pb-5 shadow-flottant transition-transform duration-500 hover:rotate-0', classes]}>
  <!-- Le ruban adhésif -->
  <span aria-hidden="true" class="absolute -top-3 left-1/2 h-6 w-20 -translate-x-1/2 rotate-2 bg-[#e6dcc4]/85 shadow-sm"></span>

  {
    photo ? (
      <Image src={photo} alt={alt} widths={[280, 560]} sizes="(min-width: 768px) 260px, 220px" class:list={[ratio, 'w-full object-cover']} />
    ) : (
      <div class:list={[ratio, 'flex w-full flex-col items-center justify-center gap-3 bg-surface text-center text-xs text-lavande-claire']}>
        <span class="font-serif text-4xl text-argent italic">W</span>
        Ta photo ici
      </div>
    )
  }

  <figcaption class="mt-4 text-center">
    <span class="block font-serif text-xl text-surface italic">{legende}</span>
    {sousLegende && <span class="mt-1 block text-[0.65rem] tracking-[0.2em] text-lavande uppercase">{sousLegende}</span>}
  </figcaption>
</figure>