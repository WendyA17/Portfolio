---
import Logo from '../assets/logo/logo-wa-petit.svg';
---

<header
  class="fixed inset-x-0 top-0 z-50 h-20 border-b border-bordure bg-surface/90 backdrop-blur-xl"
>
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between gap-6 px-5 md:px-12">
    <!-- Logo + nom : retour à l'accueil -->
    <a href="/" class="flex items-center gap-3 rounded-lg">
      <Logo class="size-10 shrink-0" aria-hidden="true" />
      <span class="font-serif text-2xl leading-none whitespace-nowrap text-lune">
        Wendy Asmatico
      </span>
    </a>

    <!-- Le sélecteur FR / EN arrivera avec la traduction -->
    <a
      href="#contact"
      class="rounded-lg bg-lavande px-5 py-2.5 text-sm font-semibold text-lune transition-[background-color,box-shadow] duration-300 hover:bg-lavande-vive hover:shadow-astre"
    >
      Collaborer
    </a>
  </div>
</header>