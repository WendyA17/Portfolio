---
// Polices auto-hébergées (pas d'appel à Google Fonts : plus rapide et conforme RGPD)
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fr' | 'en';
  /** Active le défilement section par section (scroll snap) */
  snap?: boolean;
}

const {
  title = 'Wendy Asmatico — Développeuse web créative',
  description = 'Portfolio de Wendy Asmatico, développeuse web créative et architecte frontend.',
  lang = 'fr',
  snap = false,
} = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  class:list={[
    // Sur mobile : calage « souple » (le texte long reste lisible)
    // Dès la tablette : calage strict, section par section
    snap && 'snap-y snap-proximity md:snap-mandatory',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151321" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>