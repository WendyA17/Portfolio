---
// Polices auto-hébergées (pas d'appel à Google Fonts : plus rapide et conforme RGPD)
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/caveat';
import '@fontsource-variable/inter';
import '../styles/global.css';
import CielEtoile from '../components/CielEtoile.astro';
import { langues, traductions, urlDansLangue, type Langue } from '../i18n/utils';

interface Props {
  langue: Langue;
  /** Titre de l'onglet (par défaut : celui du fichier de traduction) */
  titre?: string;
  description?: string;
  /** Active le défilement section par section (scroll snap) */
  snap?: boolean;
}

const { langue, snap = false } = Astro.props;
const t = traductions(langue);
const titre = Astro.props.titre ?? t.meta.titre;
const description = Astro.props.description ?? t.meta.description;
const base = Astro.site ?? Astro.url;
---

<!doctype html>
<html lang={langue} class:list={[snap && 'snap-y snap-proximity md:snap-mandatory']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151321" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Indique à Google que cette page existe dans chaque langue -->
    {langues.map((l) => <link rel="alternate" hreflang={l} href={new URL(urlDansLangue(Astro.url, l), base)} />)}

    <title>{titre}</title>
  </head>
  <body>
    <CielEtoile />
    <slot />
  </body>
</html>